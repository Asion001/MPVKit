+                } else {
+                    MP_WARN(vo, "MetalFX compositing pass failed.\n");
+                }
+            }
+        }
+
+        if (!used_metalfx)
+            MP_WARN(vo, "MetalFX pass failed; using the normal pass.\n");
+    }
+
+    if (!used_metalfx)
+#endif
     if (!pl_render_image_mix(p->rr, &mix, &target, &params)) {
         MP_ERR(vo, "Failed rendering frame!\n");
         goto done;
@@ -2080,6 +2303,10 @@ done:
 static void uninit(struct vo *vo)
 {
