+ */
+
+#pragma once
+
+#include <stdbool.h>
+
+#include "common/msg.h"
+
+// A MetalFX spatial upscaling pass, used by vo_gpu_next to scale the video
+// plane before libplacebo composites subtitles and OSD over it.
+//
+// Textures are allocated here and handed to libplacebo through
+// PL_HANDLE_MTL_TEX imports, so both APIs address the same memory and no copy
+// is needed between the render pass and the upscaler.
+struct mp_metalfx;
+
+struct mp_metalfx *mp_metalfx_create(struct mp_log *log);
+void mp_metalfx_destroy(struct mp_metalfx **ctx);
+
+// Whether MetalFX can scale from the given size to the given size on this
+// device. MetalFX imposes its own minimums and maximums.
+bool mp_metalfx_supported(struct mp_metalfx *ctx, int in_w, int in_h,
+                          int out_w, int out_h);
+
+// Allocates a private MTLTexture. `is_output` selects the usage flags MetalFX
+// requires for its destination. Returns a retained id<MTLTexture> as a void *,
+// or NULL. Free with mp_metalfx_texture_release().
+void *mp_metalfx_texture_create(struct mp_metalfx *ctx, int w, int h,
+                                bool is_output);
+void mp_metalfx_texture_release(void *tex);
+
+// Encodes and commits a spatial upscale. Blocks until the GPU is done, because
+// the caller hands the result straight back to libplacebo's Vulkan queue,
+// which is a different MTLCommandQueue with no shared timeline.
+bool mp_metalfx_upscale(struct mp_metalfx *ctx, void *src, void *dst,
+                        float sharpness);
diff --git a/video/out/metalfx.m b/video/out/metalfx.m
new file mode 100644
index 0000000..17a622d
--- /dev/null
+++ b/video/out/metalfx.m
@@ -0,0 +1,222 @@
+/*
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <Metal/Metal.h>
+#include <MetalFX/MetalFX.h>
+
+#include "mpv_talloc.h"
+#include "video/out/metalfx.h"
+
+// libplacebo renders into these textures over Vulkan, and MetalFX reads and
+// writes them over Metal, so both usages must be declared up front.
+#define MP_METALFX_PIXEL_FORMAT MTLPixelFormatRGBA16Float
+
+// mpv builds Objective-C without ARC, so every object here is retained and
+// released by hand and the `id` fields below are unmanaged.
+struct mp_metalfx {
+    struct mp_log *log;
+    id<MTLDevice> device;
+    id<MTLCommandQueue> queue;
+
+    // Scalers are expensive to build, so the last one is kept and reused for
+    // as long as the geometry is unchanged. Held as a bare `id` because
+    // MTLFXSpatialScaler is newer than mpv's deployment target.
+    id scaler;
+    int scaler_in_w, scaler_in_h;
+    int scaler_out_w, scaler_out_h;
+};
+
+struct mp_metalfx *mp_metalfx_create(struct mp_log *log)
+{
+    if (@available(macOS 13.0, iOS 16.0, tvOS 16.0, *)) {
+        // MetalFX exists; fall through.
+    } else {
+        mp_err(log, "MetalFX requires macOS 13, iOS 16, or newer.\n");
+        return NULL;
+    }
+
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    if (!device) {
+        mp_err(log, "No Metal device available.\n");
+        return NULL;
+    }
+
+    if (@available(macOS 13.0, iOS 16.0, tvOS 16.0, *)) {
+        if (![MTLFXSpatialScalerDescriptor supportsDevice:device]) {
+            mp_err(log, "MetalFX spatial scaling is unsupported on this device.\n");
+            [device release];
+            return NULL;
+        }
+    }
+
+    id<MTLCommandQueue> queue = [device newCommandQueue];
+    if (!queue) {
+        mp_err(log, "Could not create a Metal command queue.\n");
+        return NULL;
+    }
+
+    struct mp_metalfx *ctx = talloc_zero(NULL, struct mp_metalfx);
+    ctx->log = log;
+    ctx->device = device;
+    ctx->queue = queue;
+    return ctx;
+}
+
+void mp_metalfx_destroy(struct mp_metalfx **pctx)
+{
+    struct mp_metalfx *ctx = *pctx;
+    if (!ctx)
+        return;
+
+    [ctx->scaler release];
+    [ctx->queue release];
+    [ctx->device release];
+    ctx->scaler = nil;
+    ctx->queue = nil;
+    ctx->device = nil;
+    talloc_free(ctx);
+    *pctx = NULL;
+}
+
+bool mp_metalfx_supported(struct mp_metalfx *ctx, int in_w, int in_h,
+                          int out_w, int out_h)
+{
+    if (!ctx)
+        return false;
+
+    // MetalFX only upscales; equal or shrinking sizes must take the normal
+    // single pass instead.
+    if (in_w <= 0 || in_h <= 0 || out_w <= in_w || out_h <= in_h)
+        return false;
+
+    return true;
+}
+
+API_AVAILABLE(macos(13.0), ios(16.0), tvos(16.0))
+static id<MTLFXSpatialScaler> get_scaler(struct mp_metalfx *ctx, int in_w,
+                                         int in_h, int out_w, int out_h)
+{
+    if (ctx->scaler && ctx->scaler_in_w == in_w && ctx->scaler_in_h == in_h &&
+        ctx->scaler_out_w == out_w && ctx->scaler_out_h == out_h)
+        return ctx->scaler;
+
+    MTLFXSpatialScalerDescriptor *desc =
+        [[MTLFXSpatialScalerDescriptor alloc] init];
+    desc.inputWidth = in_w;
+    desc.inputHeight = in_h;
+    desc.outputWidth = out_w;
+    desc.outputHeight = out_h;
+    desc.colorTextureFormat = MP_METALFX_PIXEL_FORMAT;
+    desc.outputTextureFormat = MP_METALFX_PIXEL_FORMAT;
+
+    // libplacebo has already converted to the target colorspace by this point,
+    // so the data MetalFX sees is display-referred.
+    desc.colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;
+
+    id<MTLFXSpatialScaler> scaler = [desc newSpatialScalerWithDevice:ctx->device];
+    [desc release];
+    if (!scaler) {
+        MP_ERR(ctx, "Could not create a MetalFX scaler for %dx%d -> %dx%d.\n",
+               in_w, in_h, out_w, out_h);
+        return nil;
+    }
+
+    [ctx->scaler release];
+    ctx->scaler = scaler;
+    ctx->scaler_in_w = in_w;
+    ctx->scaler_in_h = in_h;
+    ctx->scaler_out_w = out_w;
+    ctx->scaler_out_h = out_h;
+    return scaler;
+}
+
+void *mp_metalfx_texture_create(struct mp_metalfx *ctx, int w, int h,
+                                bool is_output)
+{
+    if (!ctx || w <= 0 || h <= 0)
+        return NULL;
+
+    @autoreleasepool {
+    MTLTextureDescriptor *desc = [MTLTextureDescriptor
+        texture2DDescriptorWithPixelFormat:MP_METALFX_PIXEL_FORMAT
+                                     width:w
+                                    height:h
+                                 mipmapped:NO];
+
+    // Render target for libplacebo, plus whichever side of the scaler this
+    // texture is on. Shader read is always needed: the upscaled texture is
+    // sampled again by the compositing pass.
+    desc.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+    if (is_output)
+        desc.usage |= MTLTextureUsageShaderWrite;
+    desc.storageMode = MTLStorageModePrivate;
+
+    id<MTLTexture> tex = [ctx->device newTextureWithDescriptor:desc];
+    if (!tex) {
+        MP_ERR(ctx, "Could not allocate a %dx%d Metal texture.\n", w, h);
+        return NULL;
+    }
+
+    return (void *) tex;
+    }
+}
+
+void mp_metalfx_texture_release(void *tex)
+{
+    [(id<MTLTexture>) tex release];
+}
+
+bool mp_metalfx_upscale(struct mp_metalfx *ctx, void *src, void *dst,
+                        float sharpness)
+{
+    if (!ctx || !src || !dst)
+        return false;
+
+    id<MTLTexture> src_tex = (id<MTLTexture>) src;
+    id<MTLTexture> dst_tex = (id<MTLTexture>) dst;
+
+    if (@available(macOS 13.0, iOS 16.0, tvOS 16.0, *)) {
+    // The VO thread has no autorelease pool of its own, and -commandBuffer
+    // hands back an autoreleased object once per frame.
+    @autoreleasepool {
+        id<MTLFXSpatialScaler> scaler =
+            get_scaler(ctx, (int) src_tex.width, (int) src_tex.height,
+                       (int) dst_tex.width, (int) dst_tex.height);
+        if (!scaler)
+            return false;
+
+        scaler.colorTexture = src_tex;
+        scaler.outputTexture = dst_tex;
+
+        id<MTLCommandBuffer> cmd = [ctx->queue commandBuffer];
+        if (!cmd)
+            return false;
+
+        [scaler encodeToCommandBuffer:cmd];
+        [cmd commit];
+
+        // libplacebo's next pass runs on MoltenVK's own command queue, which
+        // shares no timeline with this one, so the upscale has to be finished
+        // before the texture is handed back.
+        [cmd waitUntilCompleted];
+
+        return cmd.status == MTLCommandBufferStatusCompleted;
+    }
+    }
+
+    return false;
+}
