 }
 
+#if HAVE_METALFX
+// Releases the imported MetalFX textures and their libplacebo views.
+static void metalfx_free_textures(struct priv *p)
+{
+    pl_tex_destroy(p->gpu, &p->metalfx_src);
+    pl_tex_destroy(p->gpu, &p->metalfx_dst);
+    mp_metalfx_texture_release(p->metalfx_src_mtl);
+    mp_metalfx_texture_release(p->metalfx_dst_mtl);
+    p->metalfx_src_mtl = NULL;
+    p->metalfx_dst_mtl = NULL;
+    p->metalfx_src_w = p->metalfx_src_h = 0;
+    p->metalfx_dst_w = p->metalfx_dst_h = 0;
+}
+
+// Imports one MTLTexture as a pl_tex that libplacebo can render into and
+// sample from. Mirrors what the VideoToolbox hwdec does for decoded frames.
+static pl_tex metalfx_import(struct priv *p, void *mtl_tex, int w, int h)
+{
+    pl_fmt fmt = pl_find_fmt(p->gpu, PL_FMT_FLOAT, 4, 16, 16,
+                             PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE);
+    if (!fmt) {
+        MP_ERR(p, "No renderable RGBA16F format for MetalFX.\n");
+        return NULL;
+    }
+
+    return pl_tex_create(p->gpu, pl_tex_params(
+        .w = w,
+        .h = h,
+        .format = fmt,
+        .sampleable = true,
+        .renderable = true,
+        .import_handle = PL_HANDLE_MTL_TEX,
+        .shared_mem = (struct pl_shared_mem) {
+            .handle = { .handle = mtl_tex },
+        },
+    ));
+}
+
+// Ensures both intermediate textures exist at the requested sizes.
+static bool metalfx_ensure_textures(struct priv *p, int src_w, int src_h,
+                                    int dst_w, int dst_h)
+{
+    if (p->metalfx_src && p->metalfx_dst &&
+        p->metalfx_src_w == src_w && p->metalfx_src_h == src_h &&
+        p->metalfx_dst_w == dst_w && p->metalfx_dst_h == dst_h)
+        return true;
+
+    metalfx_free_textures(p);
+
+    p->metalfx_src_mtl = mp_metalfx_texture_create(p->metalfx, src_w, src_h, false);
+    p->metalfx_dst_mtl = mp_metalfx_texture_create(p->metalfx, dst_w, dst_h, true);
+    if (!p->metalfx_src_mtl || !p->metalfx_dst_mtl)
+        goto fail;
+
+    p->metalfx_src = metalfx_import(p, p->metalfx_src_mtl, src_w, src_h);
+    p->metalfx_dst = metalfx_import(p, p->metalfx_dst_mtl, dst_w, dst_h);
+    if (!p->metalfx_src || !p->metalfx_dst)
+        goto fail;
+
+    p->metalfx_src_w = src_w;
+    p->metalfx_src_h = src_h;
+    p->metalfx_dst_w = dst_w;
+    p->metalfx_dst_h = dst_h;
+    return true;
+
+fail:
+    MP_WARN(p, "Could not set up MetalFX textures; using the normal pass.\n");
+    metalfx_free_textures(p);
+    return false;
+}
+
+// Whether this frame should take the MetalFX path.
+//
+// The video has to actually be upscaled, and the source has to be within the
+// height limit: MetalFX costs more than it gains once the source is already
+// close to the display size.
+static bool metalfx_wanted(struct priv *p, const struct pl_frame_mix *mix,
+                           int dst_w, int dst_h, int *src_w, int *src_h)
+{
+    if (!p->next_opts->metalfx || mix->num_frames < 1)
+        return false;
+
+    // The option is toggled at runtime, so the context is created on first use
+    // rather than at preinit. `metalfx_failed` keeps an unsupported device from
+    // retrying once per frame forever.
+    if (!p->metalfx) {
+        if (p->metalfx_failed)
+            return false;
+
+        p->metalfx = mp_metalfx_create(p->log);
+        if (!p->metalfx) {
+            p->metalfx_failed = true;
+            MP_WARN(p, "MetalFX is unavailable; upscaling stays off.\n");
+            return false;
+        }
+    }
+
+    const struct pl_frame *ref = mix->frames[0];
+    if (!ref || !ref->num_planes)
+        return false;
+
+    // Use the frame's crop rather than the plane size: panscan and aspect fill
+    // mean only part of the decoded frame reaches the screen, and upscaling the
+    // discarded part would both cost more and change the scale factor.
+    int w = (int) roundf(fabsf(pl_rect_w(ref->crop)));
+    int h = (int) roundf(fabsf(pl_rect_h(ref->crop)));
+    if (w <= 0 || h <= 0) {
+        w = ref->planes[0].texture ? ref->planes[0].texture->params.w : 0;
+        h = ref->planes[0].texture ? ref->planes[0].texture->params.h : 0;
+    }
+
+    // Rotation swaps what "width" means between the image and the target.
+    if (ref->rotation % PL_ROTATION_180 == PL_ROTATION_90)
+        MPSWAP(int, w, h);
+
+    if (w <= 0 || h <= 0)
+        return false;
+
+    int max_h = p->next_opts->metalfx_max_source_height;
+    if (max_h > 0 && h > max_h)
+        return false;
+
+    if (!mp_metalfx_supported(p->metalfx, w, h, dst_w, dst_h))
+        return false;
+
+    *src_w = w;
+    *src_h = h;
+    return true;
+}
+#endif
+
 static void update_overlays(struct vo *vo, struct mp_osd_res res,
                             int flags, enum pl_overlay_coords coords,
                             struct osd_state *state, struct pl_frame *frame,
@@ -1404,6 +1560,73 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
